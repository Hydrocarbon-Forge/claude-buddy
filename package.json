{
  "name": "claude-buddy",
  "productName": "Claude Buddy",
  "version": "1.0.1",
  "description": "A little Claude buddy who runs around your screen and answers your prompts.",
  "author": "Claude Buddy",
  "homepage": "https://claude.com/claude-code",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist:mac": "node scripts/make-icon.js && electron-builder --mac",
    "dist:win": "node scripts/make-icon.js && electron-builder --win",
    "dist:linux": "node scripts/make-icon.js && electron-builder --linux"
  },
  "build": {
    "appId": "com.claudebuddy.app",
    "productName": "Claude Buddy",
    "files": [
      "main.js",
      "preload.js",
      "sprite.js",
      "renderer/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Claude Buddy"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
